PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/protrack
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Email Services Configuration (Resend & Brevo with auto-failover)
RESEND_API_KEY=your_resend_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM="ProTrack Notifications <onboarding@resend.dev>"
ADMIN_EMAIL=protrack24@gmail.com

# SMTP Fallback Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=protrack24@gmail.com
SMTP_PASS=your_smtp_password_here

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
PROJECT_CREATION_FEE_INR=499
